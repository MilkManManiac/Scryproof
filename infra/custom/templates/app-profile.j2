#include <tunables/global>

# AppArmor profile for the GoOffline API process.
#
# Differs from bonesdeploy's stock Node profile in two ways:
#   - `m` on *.node files, so Node may map the prebuilt argon2 addon as
#     executable. Without it no password can be hashed or checked.
#   - loopback TCP, because Postgres is reached on 127.0.0.1.

profile {{ apparmor_profile_name }} flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  {{ apparmor_network }}

{% for exec_path in apparmor_exec_paths %}
  {{ exec_path }} mrix,
{% endfor %}

  /usr/** r,
  /bin/** r,
  /sbin/** r,
  /lib/** r,
  /lib64/** r,
  /etc/** r,
  /proc/** r,
  /sys/devices/system/cpu/online r,
  /sys/fs/cgroup/** r,

  # current is a symlink, so AppArmor mediates the resolved release path.
  {{ paths.releases }}/*/** r,
  {{ paths.releases }}/*/node_modules/**.node mr,
  # The release .env symlink resolves to the protected shared environment.
  {{ paths.shared_env }} r,
{% for write_path in apparmor_writable_paths %}
  {{ write_path }}/ rw,
  {{ write_path }}/** rwk,
{% endfor %}

  {{ paths.runtime_socket_dir }}/{{ apparmor_runtime }}/ rw,
  {{ paths.runtime_socket_dir }}/{{ apparmor_runtime }}/** rwk,

  /var/log/bonesdeploy/{{ project_name }}/ rw,
  /var/log/bonesdeploy/{{ project_name }}/** rwk,

  deny /root/** r,
  deny /etc/ssh/** r,
  deny /etc/shadow r,
}
