# GoOffline configuration.
#
# Copy to .env on the server. Never commit the real file: it is in .gitignore
# and, under bonesdeploy, the production copy lives encrypted at
# infra/secrets/.env.gpg and is pushed with `bonesdeploy secrets push`.
#
# Local development needs NONE of this. With an empty environment the server
# runs on PGlite with local file storage and an ephemeral session secret.

NODE_ENV=production

# ---------------------------------------------------------------- networking
# The API binds to localhost only; nginx terminates TLS and proxies to it.
HOST=127.0.0.1
PORT=8787

# Public origin. Used for cookies, invite links and the CSRF origin check.
# Must match exactly what people type, including https and no trailing slash.
PUBLIC_URL=https://chat.example.com

# ----------------------------------------------------------------- database
# Empty means PGlite (development). Set this in production.
DATABASE_URL=postgres://gooffline:CHANGE_ME@127.0.0.1:5432/gooffline
# Only needed for a managed database reached over the network.
DATABASE_SSL=false

# ------------------------------------------------------------------ secrets
# 64 hex characters. Generate with:  openssl rand -hex 32
# Rotating this signs everyone out and makes stored TOTP seeds unreadable,
# so rotate it deliberately, not casually.
SESSION_SECRET=CHANGE_ME_64_HEX_CHARACTERS

SESSION_TTL_DAYS=30
COOKIE_NAME=go_session

# Invite-only. Turning this off opens registration to anyone who finds the URL.
REGISTRATION_REQUIRES_INVITE=true

# ------------------------------------------------------------------ storage
# 'local' writes under DATA_DIR. 's3' targets MinIO or any S3-compatible store.
STORAGE_DRIVER=local
DATA_DIR=/var/lib/gooffline
STORAGE_PATH=uploads

# Only read when STORAGE_DRIVER=s3.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=gooffline
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# -------------------------------------------------------------------- voice
# Milestone 3. Until these are set the app runs fine with voice disabled.
# The API key and secret are whatever you put in livekit.yaml on the box.
LIVEKIT_URL=wss://voice.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Short on purpose: a leaked join token expires quickly.
LIVEKIT_TOKEN_TTL_SECONDS=900

# --------------------------------------------------------------- rate limits
RATE_LOGIN_PER_MINUTE=10
RATE_REGISTER_PER_HOUR=5
RATE_MESSAGES_PER_MINUTE=60

# ------------------------------------------------------------------ logging
# debug | info | warn | error
LOG_LEVEL=info
