# GoOffline server settings. Every variable server/src/config.ts reads.
#
# The real file is /srv/sites/gooffline/shared/.env ON THE BOX, which is on the
# encrypted vault. It is never committed and never copied to this PC.
# Values here are placeholders. Lines that are commented out show the default.

# Turns on the production rules: required secrets, PUBLIC_URL as the only origin.
NODE_ENV=production

# Where the API listens. nginx is the only thing that talks to it.
#HOST=127.0.0.1
#PORT=8787

# The public address, exactly as typed in a browser. Cookies, invite links and
# the origin check all use it. No trailing slash.
PUBLIC_URL=https://chat.example.com

# Postgres on this box. bonesdeploy writes this line; TCP on loopback.
# Leaving it empty means PGlite, which is for development only.
DATABASE_URL=postgresql://gooffline:CHANGE-ME@127.0.0.1:5432/gooffline
# Only for a database reached over a network. Ours is on loopback. (server/src/db/index.ts)
#DATABASE_SSL=false

# Where uploads and other files live. infra/custom/runtime.py sets this to the
# release's shared data folder; only set it here to override that.
#DATA_DIR=.data

# Signs session cookies. Required, 32 characters or more.
# Make one on the box:  openssl rand -hex 32
# Changing it later signs everyone out and makes stored TOTP seeds unreadable.
SESSION_SECRET=CHANGE-ME-64-hex-characters
#SESSION_TTL_DAYS=30
#COOKIE_NAME=go_session

# Invite-only sign-up. Leave it on.
#REGISTRATION_REQUIRES_INVITE=true

# Attachments. 'local' writes under DATA_DIR. 's3' is for a MinIO we run
# ourselves, never a hosted bucket (non-negotiable 1).
#STORAGE_DRIVER=local
#STORAGE_PATH=uploads
#S3_ENDPOINT=
#S3_BUCKET=gooffline
#S3_REGION=us-east-1
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=

# Voice. No defaults in production: unset means voice is off and the API says so.
# 60-livekit-install.sh prints these three lines once, when it generates the key.
# The URL is the site itself; nginx passes /rtc to LiveKit on 127.0.0.1:7880.
LIVEKIT_URL=wss://chat.example.com
LIVEKIT_API_KEY=CHANGE-ME
LIVEKIT_API_SECRET=CHANGE-ME
# How long a join token is valid, in seconds.
#LIVEKIT_TOKEN_TTL_SECONDS=900

# Rate limits.
#RATE_LOGIN_PER_MINUTE=10
#RATE_REGISTER_PER_HOUR=5
#RATE_MESSAGES_PER_MINUTE=60

# debug | info | warn | error. Production defaults to info. (server/src/lib/logger.ts)
#LOG_LEVEL=info
