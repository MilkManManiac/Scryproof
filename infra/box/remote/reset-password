#!/usr/bin/env bash
# Give someone a temporary password. From the PC:
#
#   bash scripts/box.sh reset-password <username>
#   bash scripts/box.sh reset-password <username> --clear-2fa
#
# Only after they asked, in person or on a call; send the temporary password
# back the same way, never in a Scryproof channel. They are signed out
# everywhere and choose a new password at the next sign-in. Their DMs are
# untouched. Each reset is logged to /mnt/vault/logs/password-resets.log
# (who and when, never the password).

source "$(dirname "$0")/lib.sh"
need_root
[ "$#" -ge 1 ] || die "which username? bash scripts/box.sh reset-password <username> [--clear-2fa]"
[ -e "$UNLOCKED_FLAG" ] || die "the vault is locked. Unlock first."

app=/srv/sites/scryproof/current
[ -f "$app/server/dist/reset-password.js" ] || die "this build has no reset-password.js yet. It arrives with the next deploy."

# The same node the app runs on, read from its unit rather than guessed.
node="$(systemctl show -p ExecStart --value scryproof-scryproof.service | grep -o '/[^ ;]*/bin/node' | head -1)"
[ -x "$node" ] || die "could not find the app's node binary."

say "Resetting $1"
runuser -u scryproof -- env --chdir="$app" NODE_ENV=production DATA_DIR=/srv/sites/scryproof/shared/data \
  "$node" --env-file-if-exists=.env server/dist/reset-password.js "$@"

install -d -m 0700 "$VAULT_MOUNT/logs"
printf '%s reset %s %s\n' "$(date -u +%FT%TZ)" "$1" "${2:-}" >> "$VAULT_MOUNT/logs/password-resets.log"
say "Done."
