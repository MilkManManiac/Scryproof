# Supply-chain guards. GAMEPLAN.md section 1b, finding 5.
# 2026 has had a major npm compromise roughly every two months. These three
# lines would have dodged every one of them.

# A package's install scripts run arbitrary code on this machine before any of
# our code runs. Nothing we depend on needs them (verified: npm ci with this on
# builds the server and the client). Binaries arrive through optional
# dependencies instead.
ignore-scripts=true

# "^1.2.3" means "whatever 1.x npm feels like today". Pin what we install.
save-exact=true

# Days a version must have existed before we will install it. Compromised
# releases are usually caught and unpublished within hours.
min-release-age=7
