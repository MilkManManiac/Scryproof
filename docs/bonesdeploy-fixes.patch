--- a/crates/bonesinfra/python/src/bonesinfra/assets/nginx/router.conf.j2	2026-09-21 14:06:32.784015789 -0400
+++ b/crates/bonesinfra/python/src/bonesinfra/assets/nginx/router.conf.j2	2026-09-21 14:05:45.701375835 -0400
@@ -1,9 +1,20 @@
+# WebSocket upgrade. The variable is named per project because every site's
+# router file is included into the same http block, and nginx refuses a second
+# map that defines the same variable.
+{% set ws_connection = "bones_" ~ (project_name | replace("-", "_") | replace(".", "_")) ~ "_connection" %}
+map $http_upgrade ${{ ws_connection }} {
+    default upgrade;
+    ""      "";
+}
+
 {% if preview_domain and ssl_domain and preview_domain != ssl_domain %}
 # When a real domain is configured, preview_domain redirects to it.
 server {
     listen 80;
     listen [::]:80;
     server_name {{ preview_domain }};
+    # Scryproof: no record of who connected and when.
+    access_log off;
     return 301 https://{{ ssl_domain }}$request_uri;
 }
 
@@ -12,7 +23,15 @@
     listen 80;
     listen [::]:80;
     server_name {{ nginx_server_name }};
+    # Scryproof: no record of who connected and when.
+    access_log off;
 
+{% if nginx_ssl_enabled %}
+    # Scryproof: once there is a certificate, plain HTTP only redirects.
+    location / {
+        return 301 https://$host$request_uri;
+    }
+{% else %}
     location / {
         proxy_pass http://unix:{{ paths.runtime_nginx_socket }};
         proxy_buffer_size 16k;
@@ -22,7 +41,13 @@
         proxy_set_header X-Real-IP $remote_addr;
         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
         proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_http_version 1.1;
+        proxy_set_header Upgrade $http_upgrade;
+        proxy_set_header Connection ${{ ws_connection }};
+        # Scryproof: uploads go to 100 MB. Upstream would want this defaulting to 1m.
+        client_max_body_size {{ nginx_client_max_body_size | default("110m") }};
     }
+{% endif %}
 
     location ^~ /.well-known/acme-challenge/ {
         root {{ paths.acme_webroot }};
@@ -35,6 +60,8 @@
     listen 443 ssl;
     listen [::]:443 ssl;
     server_name {{ nginx_server_name }};
+    # Scryproof: no record of who connected and when.
+    access_log off;
 
     ssl_certificate {{ nginx_ssl_certificate_path }};
     ssl_certificate_key {{ nginx_ssl_certificate_key_path }};
