# Everything that runs on the Linux box keeps Unix line endings, even in a
# Windows checkout. Several of these are piped straight over SSH from this
# machine, and bash reads a carriage return as part of the command.
*.sh    text eol=lf
*.py    text eol=lf
*.j2    text eol=lf
*.conf  text eol=lf
*.yaml  text eol=lf
*.service text eol=lf
*.mount text eol=lf
.node-version text eol=lf
.npmrc  text eol=lf
infra/box/remote/* text eol=lf
*.template text eol=lf
*.patch text eol=lf
.env.example text eol=lf
web/public/desktop-update/client.bin binary
