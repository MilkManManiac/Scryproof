node_modules/
dist/
build/
# bonesdeploy's build scripts live in a folder the line above would swallow.
!deployment/build/
.env
.env.*
!.env.example
!.env.build
# The box's address and SSH details. Not secret, but not the repo's business.
.env.box
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vite/
server/.data/
*.tsbuildinfo
coverage/
desktop/target/

# Local-only binaries (the LiveKit dev server). Downloaded, checksum-verified, never committed.
.tools/

# Python bytecode from the deploy tool
__pycache__/
*.pyc

# The desktop app: installers and unpacked builds.
desktop/release/
desktop/app-sound/app-sound.exe

# Agent worktrees, never part of the repo.
.claude/worktrees/

# Phone tour pictures (scripts/phone-tour.mjs). Regenerated, never committed.
.shots/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
# Logo drafts from imagegen; only the chosen one is kept.
assets/gen/scry-logo-*
!assets/gen/scry-logo-dial.png
